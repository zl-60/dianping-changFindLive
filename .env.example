# Compose reads .env. Set matching environment variables before running PowerShell/Java.
PET_DB_URL=jdbc:mysql://127.0.0.1:13306/petcare?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
PET_DB_USERNAME=petcare
PET_DB_PASSWORD=replace-with-your-local-password
PET_MYSQL_ROOT_PASSWORD=replace-with-a-different-local-password
PET_REDIS_HOST=127.0.0.1
PET_REDIS_PORT=6379
PET_REDIS_DATABASE=6
PET_RABBIT_HOST=127.0.0.1
PET_RABBIT_PORT=5672
PET_RABBIT_USERNAME=petcare
PET_RABBIT_PASSWORD=replace-with-your-local-password
PET_RABBIT_VHOST=/petcare
PET_ADMIN_PASSWORD=replace-with-your-admin-password
